#КонецОбласти

	&НаКлиенте
	Процедура КЛ_СкидкаПриИзменении(Элемент)
		//++ Двоенко 24.05.2026
		ЗадатьВопросИПересчитатьТабличнуюЧасть();
		//-- Двоенко 24.05.2026
	КонецПроцедуры
	
	&НаКлиенте
	Асинх Процедура ЗадатьВопросИПересчитатьТабличнуюЧасть()
		//++ Двоенко 24.05.2026
		Если Элементы.Товары.ТекущиеДанные = Неопределено И Элементы.Услуги.ТекущиеДанные = Неопределено Тогда
			Возврат
		Иначе 
			Вопрос = "Пересчитать табличные части документа?";
			
			ВариантыОтвета = Новый СписокЗначений;
			ВариантыОтвета.Добавить("Да","Да");
			ВариантыОтвета.Добавить("Нет","Нет");
			
			Ответ = Ждать ВопросАсинх(Вопрос,ВариантыОтвета);
			
			Если Ответ = "Нет" Тогда
				Возврат;
			Иначе
				ПересчитатьТабличнуюЧасть();
			КонецЕсли;
		КонецЕсли;
		//-- Двоенко 24.05.2026
	КонецПроцедуры
	
	&НаКлиенте
	Процедура ПересчитатьТабличнуюЧасть()
		//++ Двоенко 24.05.2026
		Для Каждого Строка из Объект.Товары Цикл
			РассчитатьСуммуСтроки(Строка);
		КонецЦикла;
		
		Для Каждого Строка из Объект.Услуги Цикл
			РассчитатьСуммуСтроки(Строка);
		КонецЦикла;
		Сообщить("Табличные части документа пересчитаны");
		//-- Двоенко 24.05.2026
	КонецПроцедуры

#КонецОбласти

	