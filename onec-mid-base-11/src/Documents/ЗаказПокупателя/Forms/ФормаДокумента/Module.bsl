
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ Двоенко 24.05.2026
	ГруппаСкидкаПересчет = Элементы.Добавить("ГруппаСкидкаПересчет", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево);
	ГруппаСкидкаПересчет.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидкаПересчет.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаСкидкаПересчет.ОтображатьЗаголовок = Ложь;
	
	ЭлементКонтактноеЛицо = Элементы.Вставить("КЛ_КонтактноеЛицо",Тип("ПолеФормы"),Элементы.ГруппаШапкаПраво,);
	ЭлементКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементКонтактноеЛицо.ПутьКДанным = "Объект.КЛ_КонтактноеЛицо";
	ЭлементКонтактноеЛицо.Заголовок = "Контактное лицо";  
	
	ЭлементСогласованнаяСкидка = Элементы.Вставить("КЛ_СогласованнаяСкидка",Тип("ПолеФормы"),Элементы.ГруппаСкидкаПересчет,);
	ЭлементСогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСогласованнаяСкидка.ПутьКДанным = "Объект.КЛ_СогласованнаяСкидка";
	ЭлементСогласованнаяСкидка.Заголовок = "Согласованная скидка";
	ЭлементСогласованнаяСкидка.УстановитьДействие("ПриИзменении", "КЛ_СкидкаПриИзменении");
	
	Команда = Команды.Добавить("Пересчитать");
	Команда.Заголовок = "Пересчитать";
	Команда.Действие = "ПересчитатьТабличнуюЧасть";
	
	КнопкаФормы = Элементы.Вставить("Пересчитать",Тип("КнопкаФормы"), Элементы.ГруппаСкидкаПересчет);
	КнопкаФормы.ИмяКоманды = "Пересчитать";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка; 
	//-- Двоенко 24.05.2026
	
КонецПроцедуры

