#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//++ Двоенко 24.05.2026
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	Если (ТекущиеДанные.Скидка + Объект.КЛ_СогласованнаяСкидка) >100 Тогда
		КоэффициентСкидки = 0;
		ТекущиеДанные.Скидка = 100 - Объект.КЛ_СогласованнаяСкидка;
		Сообщить(СтрШаблон("Суммарная скидка не может быть больше 100, скидка в строке %1 для %2 пересчитана",ТекущиеДанные.НомерСтроки, ТекущиеДанные.Номенклатура));
	Иначе
		КоэффициентСкидки = 1 - (ТекущиеДанные.Скидка + Объект.КЛ_СогласованнаяСкидка)/ 100;
	КонецЕсли;
	//-- Двоенко 24.05.2026
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;

	//++ Двоенко 24.05.2026
	РассчитатьСуммуДокумента();
	//-- Двоенко 24.05.2026
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

